{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHJP Baptismal Records",
  "version": "0.1.0",
  "identifier": "com.andre.baptismal-records",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SHJP Baptismal Records",
        "resizable": true,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    },
    "publisher": "Alexandre Paquibot",
    "copyright": "Copyright © 2026",
    "shortDescription": "Baptismal and First Communion records register",
    "longDescription": "Offline record-keeping tool for parish baptismal and first communion entries."
  }
}
