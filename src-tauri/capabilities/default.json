{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "fs:default", 
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        { "path": "$APPDATA/*" },
        { "path": "$APPDATA/backups" },
        { "path": "$APPDATA/backups/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/backups" },
        { "path": "$APPDATA/backups/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/backups" },
        { "path": "$APPDATA/backups/**" }
      ]
    }
  ]
}